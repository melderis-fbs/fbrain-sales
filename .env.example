# La cadena de conexión del POOLER de tu Postgres.
#
# Supabase: Connect → Connection string → Transaction pooler (puerto 6543).
# Ojo: viene con [YOUR-PASSWORD] sin reemplazar, y la conexión directa (5432)
# va sólo por IPv6, así que desde Vercel no se llega.
#
# Neon u otro: la cadena del pooler. Si trae sslmode, decide ella; conviene
# sslmode=verify-full para evitar un aviso de deprecación de pg.
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Sólo para las pruebas que escriben. Es OTRA base: las pruebas hacen truncate.
DATABASE_URL_PRUEBAS=

# Cuántas conexiones por instancia. En Vercel, pocas.
DB_MAX_CONEXIONES=

# El analizador de llamadas. Sin esto el resto de la aplicación anda igual, y el
# analizador lo dice en pantalla en vez de fallar con un error genérico.
ANTHROPIC_API_KEY=

# Qué modelo usa el analizador. Por defecto, claude-sonnet-5.
MODELO_ANALIZADOR=
