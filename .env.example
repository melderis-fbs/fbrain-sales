# La cadena del POOLER de Supabase, puerto 6543, modo transacción.
# Supabase → Connect → Transaction pooler. La conexión directa (5432) va sólo
# por IPv6 y desde Vercel no se llega.
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-region.pooler.supabase.com:6543/postgres

# Sólo para las pruebas que escriben. Es OTRA base: las pruebas hacen truncate.
DATABASE_URL_PRUEBAS=

# Cuántas conexiones por instancia. En Vercel, pocas.
DB_MAX_CONEXIONES=
